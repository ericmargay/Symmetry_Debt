# ──────────────────────────────────────────────────────────────────────────────────────────────
# Symmetry Debt — configuration
#
# Quick start:   ./scripts/setup.sh     (copies this file to .env and generates the secrets)
#
# Every setting the app reads is listed here. Each one is marked:
#   [required]   the app does not work without it
#   [optional]   leave it out and the default applies
#   [build]      read when the app is BUILT; changing it needs a rebuild / a new Docker image
#
# Keep comments on their own lines: not every tool that reads this file accepts a comment
# after a value. Never commit .env.
# ──────────────────────────────────────────────────────────────────────────────────────────────


# ── 1. Where the app lives ────────────────────────────────────────────────────────────────────

# [build] Path inside the domain. "/debt" → https://example.org/debt · "/" → https://example.org
NEXT_PUBLIC_BASE_PATH=/debt

# [required in production] Public URL people type in the browser, INCLUDING the base path and
# without a trailing slash. Invitation links and emails are built from it, and so is the
# address Google sends people back to (AUTH_URL is derived from it; do not set AUTH_URL).
#   production example:  APP_URL=https://aminoacid.com.mx/debt
APP_URL=http://localhost:3000/debt


# ── 2. Database (PostgreSQL) ──────────────────────────────────────────────────────────────────

# [required] For `npm run dev` this points at docker-compose.dev.yml (port 54329).
# docker-compose.yml ignores this value and connects the app to its own `db` service.
DATABASE_URL=postgresql://symmetry:symmetry@127.0.0.1:54329/symmetry_debt

# [required for docker-compose.yml only] Password of the bundled PostgreSQL.
# scripts/setup.sh generates it. Use only letters and digits (it ends up inside a URL).
POSTGRES_PASSWORD=


# ── 3. Sign-in with Google ────────────────────────────────────────────────────────────────────
# How to get the client id and secret: docs/en/GOOGLE_OAUTH.md · docs/es/GOOGLE_OAUTH.md
# Redirect URI to register in Google:  <APP_URL>/api/auth/callback/google

# [required] Signs session cookies and sign-in state. Generate: openssl rand -base64 32
AUTH_SECRET=

# [required] OAuth 2.0 client (type "Web application") from Google Cloud Console.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Local development WITHOUT Google credentials: run `npm run dev:auth-mock` in another terminal
# and use these three values instead of the two above. The mock issuer accepts any email
# address, so it must never be configured in a real deployment.
#   AUTH_GOOGLE_ID=symmetry-debt-local
#   AUTH_GOOGLE_SECRET=symmetry-debt-local-secret
#   AUTH_GOOGLE_ISSUER=http://localhost:4455


# ── 4. Encryption of bank details ─────────────────────────────────────────────────────────────

# [required to save bank accounts] 32 random bytes in base64. Encrypts CLABEs and account
# numbers at rest (AES-256-GCM). Generate: openssl rand -base64 32
# BACK THIS VALUE UP. Without it the stored bank details cannot be read, and a copy of the
# database moved to another server needs the SAME key.
DATA_ENCRYPTION_KEY=

# [optional] Only while rotating the key: the previous value, so data written with it can still
# be read (docs: BACKUP_AND_RECOVERY, "Rotating the encryption key").
# DATA_ENCRYPTION_KEY_PREVIOUS=


# ── 5. Receipts (uploaded files) ──────────────────────────────────────────────────────────────

# [optional] "local" keeps files in a directory; "s3" uses any S3-compatible bucket
# (AWS S3, Cloudflare R2, MinIO, Railway buckets…). The bucket must be private: files are only
# ever served through the app, after checking who is asking.
STORAGE_DRIVER=local

# [optional] Directory for STORAGE_DRIVER=local. In Docker it is always /data/uploads (a volume).
STORAGE_LOCAL_DIR=./.data/uploads

# [required when STORAGE_DRIVER=s3]
# S3_BUCKET=symmetry-debt-receipts
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# [optional] Endpoint for anything that is not AWS, region ("auto" works for R2 and MinIO) and
# path-style addressing (keep "true" for MinIO; AWS itself works with "false").
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_FORCE_PATH_STYLE=true

# [optional] [build] Largest receipt a person may upload, in MB (1–100, default 10).
MAX_UPLOAD_MB=10


# ── 6. Email ──────────────────────────────────────────────────────────────────────────────────
# Entirely optional. With "none" the app works fully: notifications are shown inside the app
# and invitation links are shared by hand.

# [optional] none | smtp | resend
EMAIL_PROVIDER=none

# [optional] Sender shown to recipients.
# EMAIL_FROM="Symmetry Debt <no-reply@example.org>"

# [required when EMAIL_PROVIDER=smtp] smtp://user:password@host:587 or smtps://user:password@host:465
# SMTP_URL=

# [required when EMAIL_PROVIDER=resend] Useful on hosts that block outbound SMTP (e.g. Railway
# plans below Pro).
# RESEND_API_KEY=


# ── 7. Due-date reminders ─────────────────────────────────────────────────────────────────────

# [optional] The server checks due dates itself on a timer. Set to "false" if you only want an
# external scheduler to do it (see CRON_SECRET).
REMINDERS_ENABLED=true

# [optional] Lets an external scheduler trigger the same job:
#   curl -X POST -H "Authorization: Bearer $CRON_SECRET" <APP_URL>/api/cron/reminders
# Without it the endpoint is disabled. Generate: openssl rand -hex 24
CRON_SECRET=


# ── 8. Defaults and limits ────────────────────────────────────────────────────────────────────

# [optional] What new accounts start with (each person can change theirs in Settings).
DEFAULT_TIME_ZONE=America/Mexico_City
DEFAULT_CURRENCY=MXN

# [optional] Days an invitation link stays valid (1–90).
INVITATION_TTL_DAYS=14

# [optional] How many reverse proxies in front of the app append to X-Forwarded-For. Used to
# find the visitor's address for rate limiting. 1 = a single proxy (Caddy, nginx…).
TRUSTED_PROXY_HOPS=1

# [optional] Rate limiting of sign-ins, changes, uploads and invitations. Leave it on.
RATE_LIMIT_ENABLED=true


# ── 9. Project links and voluntary donations ──────────────────────────────────────────────────
# All optional. A platform is only shown when its link is set; with none set, the app shows no
# donation entry at all. Donations happen on the platform itself — the app never handles money.

# PROJECT_REPO_URL=https://github.com/your-account/your-fork
# DONATE_GITHUB_SPONSORS_URL=https://github.com/sponsors/your-account
# DONATE_KOFI_URL=https://ko-fi.com/your-account
# DONATE_BUYMEACOFFEE_URL=https://buymeacoffee.com/your-account
# DONATE_PAYPAL_URL=https://paypal.me/your-account
# Any other link, as "Label|URL" pairs separated by ";"
# DONATE_OTHER_LINKS="Open Collective|https://opencollective.com/your-project;Liberapay|https://liberapay.com/your-account"


# ── 10. Docker only ───────────────────────────────────────────────────────────────────────────

# docker-compose.yml (standalone install)
# Port on this machine, and the interface it listens on. Behind a reverse proxy on the same
# machine use APP_BIND=127.0.0.1 so the app is not reachable directly from outside.
# APP_PORT=3000
# APP_BIND=0.0.0.0
# POSTGRES_USER=symmetry
# POSTGRES_DB=symmetry_debt

# Container start-up (any platform)
#   PORT=3000 and HOSTNAME=0.0.0.0 are the image defaults. On Railway set HOSTNAME=:: so the
#   service is reachable over the private network.
#   SKIP_MIGRATIONS=true   start without applying database migrations (you run them yourself)

# docker-compose.dev.yml (development services): change a port if it collides with another one
# DB_PORT=54329
# MAIL_SMTP_PORT=1025
# MAIL_UI_PORT=8025
# S3_PORT=9000
# S3_CONSOLE_PORT=9001


# ── 11. Tests ─────────────────────────────────────────────────────────────────────────────────

# [optional] Database for `npm run test:integration`. Its name MUST end in "_test". When unset,
# the tests use DATABASE_URL with "_test" appended to the database name and create it.
# TEST_DATABASE_URL=postgresql://symmetry:symmetry@127.0.0.1:54329/symmetry_debt_test
